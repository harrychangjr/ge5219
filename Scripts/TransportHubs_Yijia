# --- GE5219 Person D: Routing Flexibility (Euclidean Distance, 300 m cutoff, 100 m grid) ---

import arcpy
from arcpy import env
from arcpy.sa import *

# inputs
GDB = r"C:\Users\Ricardo\Desktop\GE5219\5219_Final_Project\5219_Final_workspace\5219_Final_workspace.gdb"

FC_MALLS = fr"{GDB}\Shopping_Malls" 
# FC_BUSSTOPS = fr"{GDB}\BusStops"  

SHAPE_MRT = r"C:\Users\Ricardo\Desktop\GE5219\5219_Final_Project\Transit_data\Stations_NEW.shp"  # MRT stations
FC_BOUNDARY = fr"{GDB}\SG_Boundary_SVY21"

# setting
CELL_SIZE_M = 100
D_MAX = 1200 

# Output paths
OUT_TEMPLATE = fr"{GDB}\SG_template_100m"
OUT_MALLS_PT = fr"{GDB}\Shopping_Malls_pt"
OUT_MRT_PJ = fr"{GDB}\Stations_NEW_SVY21"
# OUT_BUS_PJ = fr"{GDB}\BusStops_SVY21"  # [MODIFIED] Bus stops excluded
OUT_MALLS_PJ = fr"{GDB}\Shopping_Malls_SVY21"
OUT_HUBS = fr"{GDB}\All_Transport_Hubs"
OUT_HUBS_CLIP = fr"{GDB}\All_Transport_Hubs_clip"
OUT_EUCDIST = fr"{GDB}\RF_EucDist_m_100m"
OUT_SCORE = fr"{GDB}\RF_Score_0_100_100m"

#  run
arcpy.CheckOutExtension("Spatial")
env.workspace = GDB
env.overwriteOutput = True

# reset environment
env.snapRaster = None
env.mask = None
env.extent = None
env.cellSize = None


# Helper: ensure input is point type (GPT)
def ensure_points(in_fc, out_fc):
    if arcpy.Exists(out_fc):
        arcpy.management.Delete(out_fc)
    geom_type = arcpy.Describe(in_fc).shapeType
    if geom_type.lower() == "point":
        arcpy.management.CopyFeatures(in_fc, out_fc)
    else:
        arcpy.management.FeatureToPoint(in_fc, out_fc, "INSIDE")
    return out_fc

# 1) Malls to points
ensure_points(FC_MALLS, OUT_MALLS_PT)

# 2) Project all data to SVY21
for src, out in [(OUT_MALLS_PT, OUT_MALLS_PJ), (SHAPE_MRT, OUT_MRT_PJ)]:
    if arcpy.Exists(out):
        arcpy.management.Delete(out)
    arcpy.management.Project(src, out, sr)

# 3) Merge transport hubs
for ds in [OUT_HUBS, OUT_HUBS_CLIP, OUT_TEMPLATE, OUT_EUCDIST, OUT_SCORE]:
    if arcpy.Exists(ds):
        arcpy.management.Delete(ds)

inputs = [fc for fc in [OUT_MRT_PJ, OUT_MALLS_PJ] if arcpy.Exists(fc)]
if not inputs:
    raise ValueError("No valid input layers found. Check file paths.")
arcpy.management.Merge(inputs, OUT_HUBS)

# 4) Clip merged hubs to study boundary
arcpy.analysis.Clip(OUT_HUBS, FC_BOUNDARY, OUT_HUBS_CLIP)

# 5) Build 100 m raster template from boundary
tmpl = arcpy.conversion.PolygonToRaster(
    in_features=FC_BOUNDARY,
    value_field=arcpy.Describe(FC_BOUNDARY).OIDFieldName,
    out_rasterdataset=OUT_TEMPLATE,
    cell_assignment="CELL_CENTER",
    priority_field="",
    cellsize=CELL_SIZE_M
).getOutput(0)

# lock raster environment
env.snapRaster = tmpl
env.cellSize = CELL_SIZE_M
env.extent = FC_BOUNDARY
env.mask = FC_BOUNDARY

# 6) Euclidean distance (metres)
euc = EucDistance(OUT_HUBS_CLIP, cell_size=CELL_SIZE_M)
euc.save(OUT_EUCDIST)

# 7) Linear normalization: 0–100 (closer = higher comfort)
dist = Raster(OUT_EUCDIST)
score_0_1 = Con(dist <= float(D_MAX), 1 - dist / float(D_MAX), 0)
score = Int(score_0_1 * 100)
score.save(OUT_SCORE)

print(f" - Hubs merged: {OUT_HUBS}")
print(f" - Hubs clipped: {OUT_HUBS_CLIP}")
print(f" - Template raster: {OUT_TEMPLATE}")
print(f" - Euclidean (m): {OUT_EUCDIST}")
print(f" - Routing Score: {OUT_SCORE}")
